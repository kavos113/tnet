{
  "name": "@tnet/desktop",
  "version": "3.2.0",
  "private": true,
  "description": "Desktop Electron shell for tnet",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:analyze": "$env:ANALYZE=\"true\"; electron-vite build",
    "build:unpack": "pnpm --dir ../.. papers:server:build && pnpm build && electron-builder --dir",
    "build:win": "pnpm --dir ../.. papers:server:build && pnpm build && electron-builder --win",
    "build:mac": "pnpm --dir ../.. papers:server:build && pnpm build && electron-builder --mac",
    "build:linux": "pnpm --dir ../.. papers:server:build && pnpm build && electron-builder --linux"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "better-sqlite3": "catalog:",
    "es-define-property": "^1.0.1",
    "es-object-atoms": "^1.1.1",
    "get-proto": "^1.0.1",
    "googleapis": "^170.0.0",
    "gopd": "^1.2.0",
    "has-symbols": "^1.1.0",
    "hasown": "^2.0.3",
    "math-intrinsics": "^1.1.0",
    "openai": "^6.34.0",
    "string_decoder": "^1.1.1",
    "util-deprecate": "^1.0.2",
    "wrappy": "^1.0.2"
  }
}
