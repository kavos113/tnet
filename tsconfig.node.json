{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "apps/desktop/electron.vite.config.*",
    "apps/desktop/src/app/**/*",
    "apps/desktop/src/ipc/**/*",
    "apps/desktop/src/preload/**/*",
    "apps/desktop/src/services/**/*",
    "apps/desktop/src/index.ts",
    "packages/app-papers/src/main/**/*",
    "packages/app-papers/src/shared/**/*",
    "packages/app-requester/src/main/**/*",
    "packages/app-requester/src/shared/**/*",
    "packages/app-tasks/src/main/**/*",
    "packages/app-tasks/src/shared/**/*",
    "packages/app-rss/src/main/**/*",
    "packages/app-rss/src/shared/**/*",
    "packages/app-pdf-viewer/src/main/**/*",
    "packages/app-pdf-viewer/src/shared/**/*",
    "packages/app-db-inspector/src/main/**/*",
    "packages/app-db-inspector/src/shared/**/*",
    "packages/app-markdown/src/main/**/*",
    "packages/app-markdown/src/shared/**/*",
    "packages/markdown-editor/src/shared/**/*",
    "packages/main-core/src/**/*",
    "packages/shared/src/**/*",
    "vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node", "node"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["./apps/desktop/src/*"],
      "@preload/*": ["./apps/desktop/src/preload/*"],
      "@renderer/*": ["./apps/desktop/src/renderer/src/*"],
      "@shared/*": ["./packages/shared/src/*"],
      "@tnet/app-papers/main": ["./packages/app-papers/src/main/index.ts"],
      "@tnet/app-papers/main/*": ["./packages/app-papers/src/main/*"],
      "@tnet/app-papers/renderer": ["./packages/app-papers/src/renderer/index.ts"],
      "@tnet/app-papers/renderer/*": ["./packages/app-papers/src/renderer/*"],
      "@tnet/app-papers/shared/*": ["./packages/app-papers/src/shared/*"],
      "@tnet/app-requester/main": ["./packages/app-requester/src/main/index.ts"],
      "@tnet/app-requester/main/*": ["./packages/app-requester/src/main/*"],
      "@tnet/app-requester/renderer": ["./packages/app-requester/src/renderer/index.ts"],
      "@tnet/app-requester/renderer/*": ["./packages/app-requester/src/renderer/*"],
      "@tnet/app-requester/shared/*": ["./packages/app-requester/src/shared/*"],
      "@tnet/app-tasks/main": ["./packages/app-tasks/src/main/index.ts"],
      "@tnet/app-tasks/main/*": ["./packages/app-tasks/src/main/*"],
      "@tnet/app-tasks/renderer": ["./packages/app-tasks/src/renderer/index.ts"],
      "@tnet/app-tasks/renderer/*": ["./packages/app-tasks/src/renderer/*"],
      "@tnet/app-tasks/shared/*": ["./packages/app-tasks/src/shared/*"],
      "@tnet/app-rss/main": ["./packages/app-rss/src/main/index.ts"],
      "@tnet/app-rss/main/*": ["./packages/app-rss/src/main/*"],
      "@tnet/app-rss/renderer": ["./packages/app-rss/src/renderer/index.ts"],
      "@tnet/app-rss/renderer/*": ["./packages/app-rss/src/renderer/*"],
      "@tnet/app-rss/shared/*": ["./packages/app-rss/src/shared/*"],
      "@tnet/app-pdf-viewer/main": ["./packages/app-pdf-viewer/src/main/index.ts"],
      "@tnet/app-pdf-viewer/main/*": ["./packages/app-pdf-viewer/src/main/*"],
      "@tnet/app-pdf-viewer/renderer": ["./packages/app-pdf-viewer/src/renderer/index.ts"],
      "@tnet/app-pdf-viewer/renderer/*": ["./packages/app-pdf-viewer/src/renderer/*"],
      "@tnet/app-pdf-viewer/shared/*": ["./packages/app-pdf-viewer/src/shared/*"],
      "@tnet/app-db-inspector/main": ["./packages/app-db-inspector/src/main/index.ts"],
      "@tnet/app-db-inspector/main/*": ["./packages/app-db-inspector/src/main/*"],
      "@tnet/app-db-inspector/renderer": ["./packages/app-db-inspector/src/renderer/index.ts"],
      "@tnet/app-db-inspector/renderer/*": ["./packages/app-db-inspector/src/renderer/*"],
      "@tnet/app-db-inspector/shared/*": ["./packages/app-db-inspector/src/shared/*"],
      "@tnet/app-markdown/main": ["./packages/app-markdown/src/main/index.ts"],
      "@tnet/app-markdown/main/*": ["./packages/app-markdown/src/main/*"],
      "@tnet/app-markdown/renderer": ["./packages/app-markdown/src/renderer/index.ts"],
      "@tnet/app-markdown/renderer/*": ["./packages/app-markdown/src/renderer/*"],
      "@tnet/app-markdown/shared/*": ["./packages/app-markdown/src/shared/*"],
      "@tnet/markdown-editor/shared/*": ["./packages/markdown-editor/src/shared/*"],
      "@tnet/main-core/*": ["./packages/main-core/src/*"],
      "@tnet/renderer-core/*": ["./packages/renderer-core/src/*"],
      "@tnet/shared/*": ["./packages/shared/src/*"],
      "@tnet/ui/*": ["./packages/ui/src/*"]
    }
  }
}
