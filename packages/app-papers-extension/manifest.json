{
  "manifest_version": 3,
  "name": "TNet Paper Connector",
  "version": "0.1.0",
  "description": "Import papers into the local TNet Paper backend.",
  "permissions": ["clipboardRead"],
  "host_permissions": ["http://127.0.0.1:38911/*"],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  }
}
