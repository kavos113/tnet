{
  "name": "tnet-workspace",
  "version": "3.1.0",
  "private": true,
  "description": "Workspace for the tnet Electron app and packages",
  "scripts": {
    "format": "oxfmt",
    "lint": "oxlint",
    "sqlite:node": "powershell -ExecutionPolicy Bypass -File scripts/rebuild-sqlite-abi.ps1 -Target node",
    "sqlite:electron": "powershell -ExecutionPolicy Bypass -File scripts/rebuild-sqlite-abi.ps1 -Target electron",
    "db-inspector:integration": "powershell -ExecutionPolicy Bypass -File scripts/db-inspector-integration.ps1",
    "papers:proto": "buf generate",
    "papers:server:build": "powershell -ExecutionPolicy Bypass -File scripts/paper-server-build.ps1",
    "papers:server:mocks": "cd services/papers-server && go generate ./...",
    "papers:server:test": "powershell -ExecutionPolicy Bypass -File scripts/paper-server-test.ps1",
    "papers:server:test:coverage": "powershell -ExecutionPolicy Bypass -File scripts/paper-server-test.ps1 cover",
    "papers:server:test:coverage:filtered": "powershell -ExecutionPolicy Bypass -File scripts/paper-server-coverage.ps1",
    "papers:extension:build": "pnpm --filter @tnet/app-papers-extension build",
    "test": "pnpm sqlite:node && vitest run",
    "test:coverage": "pnpm sqlite:node && vitest run --coverage",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "start": "pnpm --filter @tnet/desktop start",
    "dev": "pnpm --filter @tnet/desktop dev",
    "verify:dev": "pnpm sqlite:electron && pnpm papers:server:build && pnpm papers:extension:build && powershell -ExecutionPolicy Bypass -File scripts/verify-dev.ps1",
    "build": "pnpm typecheck && pnpm --filter @tnet/desktop build",
    "build:analyze": "pnpm --filter @tnet/desktop build:analyze",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm --filter @tnet/desktop build:unpack",
    "build:win": "pnpm --filter @tnet/desktop build:win",
    "build:mac": "pnpm --filter @tnet/desktop build:mac",
    "build:linux": "pnpm --filter @tnet/desktop build:linux"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "^1.50.1",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "0.8.0",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "@reduxjs/toolkit": "^2.11.2",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.3.9",
    "googleapis": "^170.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "material-icons": "^1.13.14",
    "mermaid": "^11.14.0",
    "openai": "^6.34.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "1.10.1",
    "@connectrpc/protoc-gen-connect-es": "1.7.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@protobuf-ts/plugin": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.1.5",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.7.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^7.2.6",
    "vite-plugin-static-copy": "^4.1.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
